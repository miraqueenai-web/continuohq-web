---
// Etkileşimli asistan örneği: ziyaretçi sektör ve soru seçer, örnek asistan yanıtlar.
// Yanıtlar önceden hazırlanmıştır; gerçek asistan işletmenin kendi bilgisiyle kurulur.
import { site, whatsappHref } from '../config/site';
export interface Props { id?: string; compact?: boolean }
const { id = 'deneyin', compact = false } = Astro.props;

type QA = { q: string; a: string; handoff?: boolean };
const sectors: { key: string; label: string; name: string; hello: string; qa: QA[] }[] = [
  { key: 'otel', label: 'Otel', name: 'Örnek Otel', hello: "Merhaba! Örnek Otel'in asistanıyım. Rezervasyon, oda ve hizmetlerimizle ilgili sorularınızı yanıtlayabilirim.", qa: [
    { q: 'Kahvaltı fiyata dahil mi?', a: 'Evet, tüm oda fiyatlarımıza açık büfe kahvaltı dahil. Kahvaltı her gün 07:30 ile 10:30 arasında servis ediliyor.' },
    { q: 'Havalimanından transfer var mı?', a: 'Evet, ücretli transfer hizmetimiz var. Uçuş saatinizi yazarsanız uygunluğu kontrol edip rezervasyon ekibimize iletiyorum.' },
    { q: 'Evcil hayvan kabul ediyor musunuz?', a: 'Küçük ırk evcil hayvanları belirli odalarımızda kabul ediyoruz. Tarihlerinizi paylaşırsanız uygun odayı kontrol edeyim.' },
    { q: 'Rezervasyonumu iptal etmek istiyorum.', a: 'Rezervasyon değişiklikleri için sizi resepsiyon ekibimize bağlıyorum. Rezervasyon numaranızı yazarsanız konuşmayı hemen devralacaklar.', handoff: true },
  ] },
  { key: 'guzellik', label: 'Güzellik merkezi', name: 'Örnek Güzellik Merkezi', hello: 'Merhaba! Örnek Güzellik Merkezi’nin asistanıyım. Hizmetlerimiz ve randevularınızla ilgili size yardımcı olabilirim.', qa: [
    { q: 'Cilt bakımı ne kadar sürüyor?', a: 'Klasik cilt bakımımız yaklaşık 60 dakika sürüyor. Size uygun gün ve saati yazarsanız müsaitliği kontrol edeyim.' },
    { q: 'Bu cumartesi yer var mı?', a: 'Cumartesi 11:00 ve 15:30 boş görünüyor. Hangisini sizin için ayırayım?' },
    { q: 'Fiyat listenizi alabilir miyim?', a: 'Güncel fiyat listemizi hemen iletiyorum. Paket ve kampanyalarla ilgili sorularınız olursa ekibimiz de yardımcı olabilir.' },
    { q: 'Son işlemden sonra cildimde kızarıklık oldu.', a: 'Geçmiş olsun. Bu durumun uzmanımız tarafından değerlendirilmesi gerekiyor; sizi hemen ekibimize bağlıyorum.', handoff: true },
  ] },
  { key: 'diyet', label: 'Diyetisyen', name: 'Örnek Beslenme Danışmanlığı', hello: 'Merhaba! Örnek Beslenme Danışmanlığı’nın asistanıyım. Randevu ve görüşmelerle ilgili sorularınızı yanıtlayabilirim.', qa: [
    { q: 'Online görüşme yapıyor musunuz?', a: 'Evet, online görüşmelerimiz var. Size uygun saatleri ve ücret bilgisini iletiyorum.' },
    { q: 'İlk görüşmede neler yapılıyor?', a: 'İlk görüşmede beslenme alışkanlıklarınız ve hedefleriniz konuşulur, ölçümleriniz alınır. Görüşme yaklaşık 45 dakika sürer.' },
    { q: 'Randevumu bir gün ileri alabilir miyim?', a: 'Elbette. Yarın 10:00 ve 16:00 uygun görünüyor; hangisine alayım?' },
    { q: 'Kan değerlerime göre ne yemeliyim?', a: 'Bu, sağlık bilgilerinize dayanan bir değerlendirme gerektiriyor; diyetisyenimiz görüşmede sizinle birlikte ele alacak. Size en yakın uygun randevuyu önereyim mi?', handoff: true },
  ] },
];
const first = sectors[0];
const wa = site.whatsapp ? whatsappHref('Merhaba, asistanınızı denemek istiyorum.') : '';
---
<section class={`sec demo-sec${compact ? ' paper' : ''}`} id={id}>
  <div class="container demo-grid">
    <div class="demo-copy">
      <span class="eyebrow">Deneyin</span>
      <h2>Bir AI asistanla konuşmak nasıl bir deneyim?</h2>
      <p class="demo-lead">Bir sektör ve bir soru seçin. Asistanın sık sorulan soruları nasıl yanıtladığını, randevuya nasıl yönlendirdiğini ve hassas bir konuda konuşmayı nasıl ekibe devrettiğini görün.</p>
      <ul class="demo-points">
        <li><b>İşletmenin bilgisiyle yanıtlar.</b> Fiyat, saat, hizmet ve kurallar asistanın bilgi bankasından gelir.</li>
        <li><b>Randevuya taşır.</b> Müsait saatleri önerir, seçimi takvime işler.</li>
        <li><b>Gerektiğinde devreder.</b> Şikâyet ve sağlıkla ilgili sorular ekibe aktarılır.</li>
      </ul>
      <div class="ctas">
        {wa && <a class="btn btn-dark" href={wa} target="_blank" rel="noopener">Gerçek asistanımızla WhatsApp'tan konuşun</a>}
        <a class={`btn ${wa ? 'btn-line' : 'btn-dark'}`} href="/randevu">İşletmeniz için konuşalım</a>
      </div>
    </div>
    <div class="demo-box" data-demo data-sectors={JSON.stringify(sectors)}>
      <div class="demo-tabs" role="tablist" aria-label="Sektör seçin">
        {sectors.map((s, i) => <button type="button" role="tab" class="demo-tab" aria-selected={i === 0 ? 'true' : 'false'} data-key={s.key}>{s.label}</button>)}
      </div>
      <div class="demo-chat">
        <div class="chat-head">
          <span class="av" style="--mk-ink:#111"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#mk"/></svg></span>
          <span><b data-name>{first.name}</b><small>Asistan · çevrim içi</small></span>
        </div>
        <div class="demo-msgs" data-msgs aria-live="polite">
          <div class="m out">{first.hello}</div>
        </div>
        <div class="demo-chips" data-chips aria-label="Örnek sorular">
          {first.qa.map((x, i) => <button type="button" class="demo-chip" data-i={i}>{x.q}</button>)}
        </div>
      </div>
      <p class="demo-note">Etkileşimli örnek: yanıtlar tanıtım amacıyla önceden hazırlanmıştır. Gerçek asistan işletmenizin bilgisiyle kurulur ve serbest yazılan soruları da yanıtlar.</p>
    </div>
  </div>
</section>

<script>
  type QA = { q: string; a: string; handoff?: boolean };
  type Sector = { key: string; label: string; name: string; hello: string; qa: QA[] };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-demo]').forEach((box) => {
    const sectors: Sector[] = JSON.parse(box.dataset.sectors || '[]');
    const msgs = box.querySelector<HTMLElement>('[data-msgs]')!;
    const chips = box.querySelector<HTMLElement>('[data-chips]')!;
    const name = box.querySelector<HTMLElement>('[data-name]')!;
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('.demo-tab')];
    let cur = sectors[0];
    let busy = false;
    const asked = new Set<number>();
    const bubble = (cls: string, text: string) => {
      const el = document.createElement('div');
      el.className = `m ${cls}`;
      el.textContent = text;
      msgs.append(el);
      msgs.scrollTop = msgs.scrollHeight;
      return el;
    };
    const renderChips = () => {
      chips.replaceChildren(...cur.qa.map((x, i) => {
        const b = document.createElement('button');
        b.type = 'button'; b.className = 'demo-chip'; b.textContent = x.q; b.dataset.i = String(i);
        b.disabled = asked.has(i);
        return b;
      }));
    };
    const setSector = (key: string) => {
      const s = sectors.find((x) => x.key === key);
      if (!s || busy) return;
      cur = s; asked.clear();
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.key === key)));
      name.textContent = s.name;
      msgs.replaceChildren();
      bubble('out', s.hello);
      renderChips();
    };
    tabs.forEach((t) => t.addEventListener('click', () => setSector(t.dataset.key!)));
    chips.addEventListener('click', async (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.demo-chip');
      if (!b || busy || b.disabled) return;
      const i = Number(b.dataset.i);
      const qa = cur.qa[i];
      busy = true; asked.add(i);
      chips.querySelectorAll('button').forEach((x) => ((x as HTMLButtonElement).disabled = true));
      bubble('in', qa.q);
      const typing = bubble('out typing', '');
      typing.innerHTML = '<i></i><i></i><i></i>';
      await new Promise((r) => setTimeout(r, reduce ? 0 : 1100));
      typing.remove();
      bubble('out', qa.a);
      if (qa.handoff) bubble('handoff', 'Konuşma ekibe devredildi');
      busy = false;
      renderChips();
      if (asked.size === cur.qa.length) {
        const again = document.createElement('button');
        again.type = 'button'; again.className = 'demo-chip demo-again'; again.textContent = 'Baştan başla';
        again.addEventListener('click', () => setSector(cur.key));
        chips.replaceChildren(again);
      }
    });
  });
</script>
