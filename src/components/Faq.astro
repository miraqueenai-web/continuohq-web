---
import type { Faq } from '../data/services';
import { langOf, t } from '../i18n';
export interface Props { faqs: Faq[]; title?: string }
const L = t(langOf(Astro.url.pathname));
const { faqs, title = L.faqTitle } = Astro.props;
---
<section class="sec" aria-labelledby="sss">
  <div class="container">
    <div class="sec-head"><span class="eyebrow">{L.faqEyebrow}</span><h2 id="sss">{title}</h2></div>
    <div class="faq">
      {faqs.map((f, i) => <details open={i === 0}><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </div>
</section>
