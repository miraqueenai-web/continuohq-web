---
import { site } from '../config/site';
import { langOf, altPath, link, t } from '../i18n';
import { data } from '../data';

const lang = langOf(Astro.url.pathname);
const L = t(lang);
const { groups, services, sectors, serviceUrl, sectorUrl, groupUrl, sectorsUrl } = data(lang);
const book = link(site.bookingPage, lang);
const en = lang === 'en';
const alt = altPath(Astro.url.pathname);
const switchHref = alt ? alt.path : en ? '/' : '/en';
const M = en
  ? {
      asGuide: 'What is an AI assistant?', asNote: 'Full guide and all assistants',
      asFeatLive: { ey: 'Try it live', title: 'Chat with our assistant now', text: 'Get to know the product by talking to it. Replies arrive in seconds.', btn: 'Start chatting' },
      asFeat: { ey: '30 minutes, free', title: "Let's find the right assistant", text: "Tell us about your message volume and we'll work out which assistant fits your business.", btn: 'Book a call' },
      tfGuide: 'What is AI transformation?', tfNote: 'Full guide and all services',
      tfFeat: { ey: '30 minutes, free', title: 'Discovery call', text: "We listen to how you work and map out the steps that can be automated.", btn: 'Book a call' },
      scFeat: { ey: "Don't see your industry?", title: 'Tell us about your processes', text: 'Every business has work that can be automated.', btn: 'Tell us' },
    }
  : {
      asGuide: 'AI asistan nedir?', asNote: 'Kapsamlı rehber ve tüm asistanlar',
      asFeatLive: { ey: 'Canlı deneyin', title: 'Asistanımızla şimdi konuşun', text: 'Ürünümüzü sohbet ederek tanıyın. Yanıtlar saniyeler içinde.', btn: 'Konuşmayı başlat' },
      asFeat: { ey: '30 dakika, ücretsiz', title: 'Size uygun asistanı bulalım', text: 'Mesaj trafiğinizi konuşalım, hangi asistanın işinize yarayacağını birlikte belirleyelim.', btn: 'Görüşme planla' },
      tfGuide: 'AI dönüşümü nedir?', tfNote: 'Kapsamlı rehber ve tüm hizmetler',
      tfFeat: { ey: '30 dakika, ücretsiz', title: 'Keşif görüşmesi', text: 'İşinizi dinleyelim, otomatikleşebilecek adımları birlikte çıkaralım.', btn: 'Görüşme planla' },
      scFeat: { ey: 'Sektörünüz yok mu?', title: 'Süreçlerinizi anlatın', text: 'Her işletmenin otomatikleşebilecek bir işi vardır.', btn: 'Bize anlatın' },
    };

const menus = [
  {
    id: 'asistan', title: groups['ai-asistanlar'].title, href: groupUrl('ai-asistanlar'), guide: M.asGuide, guideNote: M.asNote,
    items: services.filter((s) => s.group === 'ai-asistanlar').map((s) => ({ title: s.title, note: s.short, href: serviceUrl(s) })),
    feat: site.whatsapp ? { ...M.asFeatLive, href: `https://wa.me/${site.whatsapp}` } : { ...M.asFeat, href: book },
  },
  {
    id: 'donusum', title: groups['ai-donusumu'].title, href: groupUrl('ai-donusumu'), guide: M.tfGuide, guideNote: M.tfNote,
    items: services.filter((s) => s.group === 'ai-donusumu').map((s) => ({ title: s.title, note: s.short, href: serviceUrl(s) })),
    feat: { ...M.tfFeat, href: book },
  },
  {
    id: 'sektor', title: L.sectors, href: sectorsUrl, guide: undefined as string | undefined, guideNote: undefined as string | undefined,
    items: sectors.map((s) => ({ title: s.title, note: s.menuNote, href: sectorUrl(s) })),
    feat: { ...M.scFeat, href: book },
  },
];
const plain = [
  { title: L.howWeWork, href: link('/nasil-calisiriz', lang) },
  ...(en ? [] : [{ title: 'Blog', href: '/blog' }]),
  { title: L.about, href: link('/hakkimizda', lang) },
];
const ext = (h: string) => h.startsWith('http');
---
<header class="nav" id="nav">
  <div class="bar">
    <a class="logo" href={link('/', lang)} aria-label={L.homeAria}><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#mk"/></svg>continuo</a>
    <ul class="nav-links" id="links">
      <span class="hl" aria-hidden="true"></span>
      {menus.map((m) => <li><a class="nav-top" href={m.href} aria-haspopup="true" aria-expanded="false" aria-controls={`dd-${m.id}`} data-menu={m.id}>{m.title}</a></li>)}
      {plain.map((p) => <li><a href={p.href}>{p.title}</a></li>)}
    </ul>
    <div class="nav-right">
      <a class="lang-sw" href={switchHref} hreflang={en ? 'tr' : 'en'} lang={en ? 'tr' : 'en'} aria-label={L.langSwitchAria}><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg><span>{en ? 'TR' : 'EN'}</span></a>
      <a class="btn btn-dark btn-sm" href={book}>{L.bookShort}</a>
      <button type="button" class="burger" aria-expanded="false" aria-controls="sheet" aria-label={L.menuOpen} data-open={L.menuOpen} data-close={L.menuClose}><span></span><span></span></button>
    </div>
    {menus.map((m) => (
      <div class="dd" id={`dd-${m.id}`} role="region" aria-label={m.title} hidden>
        <ul class="dd-list">
          {m.items.map((i) => <li><a href={i.href} class="dd-item"><span class="dd-txt"><b>{i.title}</b><small>{i.note}</small></span></a></li>)}
          <li><a href={m.href} class="dd-item"><span class="dd-txt"><b>{m.guide ?? L.seeAll}</b><small>{m.guideNote ?? `${m.title} ${L.homeOf}`}</small></span></a></li>
        </ul>
        <div class="dd-feat"><span class="dd-ey">{m.feat.ey}</span><b>{m.feat.title}</b><p>{m.feat.text}</p><a class="dd-btn" href={m.feat.href} {...(ext(m.feat.href) ? { target: '_blank', rel: 'noopener' } : {})}>{m.feat.btn} →</a></div>
      </div>
    ))}
  </div>
</header>
<div class="sh-back" id="shback" hidden></div>
<div class="sheet" id="sheet" hidden>
  <span class="sh-handle" aria-hidden="true"></span>
  <ul class="sh-list">
    {menus.map((m) => (
      <li class="sh-group">
        <button type="button" class="sh-top" aria-expanded="false">{m.title}<span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span></button>
        <ul class="sh-sub" hidden>
          {m.items.map((i) => <li><a href={i.href}>{i.title}</a></li>)}
          <li><a href={m.href}>{m.guide ?? L.seeAll}</a></li>
        </ul>
      </li>
    ))}
    {plain.map((p) => <li><a class="sh-plain" href={p.href}>{p.title}</a></li>)}
  </ul>
  <a class="sh-lang" href={switchHref} hreflang={en ? 'tr' : 'en'} lang={en ? 'tr' : 'en'}>{L.langSwitch}</a>
  <a class="btn btn-dark sh-cta" href={book}>{L.bookLong}</a>
</div>

<script>
  const nav = document.getElementById('nav')!;
  const bar = nav.querySelector('.bar') as HTMLElement;
  const links = document.getElementById('links')!;
  const hl = links.querySelector('.hl') as HTMLElement;
  const dds = () => document.querySelectorAll<HTMLElement>('.dd');
  const tops = () => document.querySelectorAll<HTMLAnchorElement>('.nav-top');
  let openId: string | null = null;
  let closeT: number | undefined;
  function moveHl(el: HTMLElement | null) {
    if (!el) { hl.style.opacity = '0'; return; }
    const lr = links.getBoundingClientRect(), r = el.getBoundingClientRect();
    hl.style.width = r.width + 'px'; hl.style.transform = `translateX(${r.left - lr.left}px)`; hl.style.opacity = '1';
  }
  function placeDd(dd: HTMLElement, btn: HTMLElement) {
    const br = bar.getBoundingClientRect(), r = btn.getBoundingClientRect(), w = dd.offsetWidth;
    let left = r.left + r.width / 2 - w / 2 - br.left;
    left = Math.max(0, Math.min(left, br.width - w));
    dd.style.left = left + 'px';
  }
  function hideAll() {
    dds().forEach((d) => { d.hidden = true; d.classList.remove('open'); });
    tops().forEach((b) => b.setAttribute('aria-expanded', 'false'));
    openId = null;
  }
  function openMenu(id: string, btn: HTMLElement) {
    clearTimeout(closeT);
    if (openId === id) return;
    dds().forEach((d) => { const on = d.id === 'dd-' + id; d.hidden = !on; d.classList.toggle('open', on); if (on) placeDd(d, btn); });
    tops().forEach((b) => b.setAttribute('aria-expanded', String(b.dataset.menu === id)));
    openId = id;
  }
  function closeMenu() { hideAll(); moveHl(null); }
  links.querySelectorAll<HTMLElement>('li > a').forEach((el) => el.addEventListener('mouseenter', () => {
    moveHl(el);
    if (el.dataset.menu) openMenu(el.dataset.menu, el); else closeT = window.setTimeout(hideAll, 100);
  }));
  // Başlığa tıklamak rehber sayfasını açar; fareyle üzerine gelince alt menü açılır.
  // Dokunmatik ekranda ilk dokunuş alt menüyü açar, ikinci dokunuş sayfaya gider.
  let touchWasOpen: boolean | null = null;
  tops().forEach((b) => {
    b.addEventListener('pointerdown', (e) => { touchWasOpen = e.pointerType === 'mouse' ? null : openId === b.dataset.menu; });
    b.addEventListener('click', (e) => {
      if (touchWasOpen === false) { e.preventDefault(); moveHl(b); openMenu(b.dataset.menu!, b); }
      touchWasOpen = null;
    });
    b.addEventListener('focus', () => { if (b.matches(':focus-visible')) { moveHl(b); openMenu(b.dataset.menu!, b); } });
    b.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); openMenu(b.dataset.menu!, b); document.querySelector<HTMLAnchorElement>(`#dd-${b.dataset.menu} a`)?.focus(); }
    });
  });
  nav.addEventListener('mouseleave', () => { closeT = window.setTimeout(closeMenu, 200); });
  nav.addEventListener('mouseenter', () => clearTimeout(closeT));
  document.addEventListener('click', (e) => { if (openId && !nav.contains(e.target as Node)) closeMenu(); });

  const burger = document.querySelector('.burger') as HTMLButtonElement;
  const sheet = document.getElementById('sheet')!;
  const shback = document.getElementById('shback')!;
  function setSheet(on: boolean) {
    sheet.hidden = !on; shback.hidden = !on; sheet.classList.toggle('open', on);
    burger.setAttribute('aria-expanded', String(on)); burger.setAttribute('aria-label', (on ? burger.dataset.close : burger.dataset.open)!);
    document.body.style.overflow = on ? 'hidden' : '';
  }
  burger.addEventListener('click', () => setSheet(sheet.hidden));
  shback.addEventListener('click', () => setSheet(false));
  document.querySelectorAll<HTMLButtonElement>('.sh-top').forEach((b) => b.addEventListener('click', () => {
    const sub = b.nextElementSibling as HTMLElement; const on = sub.hidden; sub.hidden = !on; b.setAttribute('aria-expanded', String(on));
  }));
  sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setSheet(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { closeMenu(); setSheet(false); } });
</script>
