---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Faq from './Faq.astro';
import CtaBand from './CtaBand.astro';
import { site } from '../config/site';
import type { Service } from '../data/services';
import { data } from '../data';
import { langOf, link, t } from '../i18n';
export interface Props { s: Service }
const { s } = Astro.props;
const lang = langOf(Astro.url.pathname);
const L = t(lang);
const en = lang === 'en';
const { groups, guides, serviceBySlug, sectorBySlug, serviceUrl, sectorUrl, groupUrl } = data(lang);
const author = link('/yazar/neslisah-gokkaya', lang);
const consulting = s.slug === 'donusum-danismanligi' || s.slug === 'ai-consulting';
const W = en
  ? { change: 'What changes?', gain: `What ${s.title} gives you`, how: 'How we set it up', stepsC: 'How we work', steps: 'Setup steps', step: (n: number) => `Step ${n}`, who: 'Who is it for?', fits: 'Industries it suits', rel: 'Related services', relT: 'Works well alongside' }
  : { change: 'Ne değişir?', gain: `${s.title} size ne kazandırır?`, how: 'Nasıl kuruyoruz?', stepsC: 'Çalışma adımları', steps: 'Kurulum adımları', step: (n: number) => `${n}. adım`, who: 'Kimler için?', fits: 'Uygun olduğu sektörler', rel: 'İlgili hizmetler', relT: 'Bununla birlikte kullanılabilecekler' };
const g = groups[s.group];
const url = `${site.url}${serviceUrl(s)}`;
const related = s.related.map(serviceBySlug).filter(Boolean) as Service[];
const secs = s.sectors.map(sectorBySlug).filter(Boolean);
const gd = s.guide ?? guides[s.slug];
const updTr = gd ? new Date(gd.updated).toLocaleDateString(en ? 'en-GB' : 'tr-TR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';
const ld = [
  { '@context': 'https://schema.org', '@type': 'Service', name: s.title, description: s.description, url, serviceType: s.title, inLanguage: L.inLanguage, areaServed: { '@type': 'Country', name: 'Türkiye' }, provider: { '@id': `${site.url}/#organization` } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: s.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: L.home, item: `${site.url}${link('/', lang) === '/' ? '' : link('/', lang)}` },
    { '@type': 'ListItem', position: 2, name: g.title, item: `${site.url}${groupUrl(s.group)}` },
    { '@type': 'ListItem', position: 3, name: s.title, item: url } ] },
  ...(gd ? [{ '@context': 'https://schema.org', '@type': 'Article', headline: s.seoTitle, description: s.description, inLanguage: L.inLanguage, mainEntityOfPage: url, dateModified: new Date(gd.updated).toISOString(), author: { '@type': 'Person', '@id': `${site.url}/yazar/neslisah-gokkaya#person`, name: site.founder, url: `${site.url}${author}` }, publisher: { '@id': `${site.url}/#organization` } }] : []),
];
---
<Base title={s.seoTitle} description={s.description} type={s.guide ? 'article' : undefined} jsonld={ld}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ name: g.title, href: groupUrl(s.group) }, { name: s.title, href: serviceUrl(s) }]} />
      <h1>{s.title}</h1>
      <p class="lead">{s.lead}</p>
      <div class="answer"><strong>{L.inShort}</strong>{s.answer}</div>
      <div class="ctas">
        <a class="btn btn-dark" href={link(site.bookingPage, lang)}>{L.bookLong}</a>
        <a class="btn btn-line" href={link('/iletisim', lang)}>{L.writeUs}</a>
      </div>
      {gd && <p class="byline">{L.preparedBy}: <a href={author}>{site.founder}</a> · {L.updated}: <time datetime={gd.updated}>{updTr}</time></p>}
      {gd && <nav class="toc" aria-label={L.onThisPage}><span class="toc-k">{L.onThisPage}</span>{gd.sections.map((x) => <a href={`#${x.id}`}>{x.title}</a>)}</nav>}
    </div>
  </section>
  {gd && gd.sections.map((x, i) => (
    <section class={`gsec${i % 2 ? ' paper' : ''}`} id={x.id}>
      <div class="container">
        <span class="eyebrow">{x.eyebrow}</span>
        <h2>{x.title}</h2>
        <p class="intro" set:html={x.intro} />
        {x.paras && <div class="prose">{x.paras.map((p) => <p set:html={p} />)}</div>}
        {x.cards && <div class={`steps-g${x.id === 'anatomi' || x.id === 'anatomy' ? '' : ' plain'}`}>{x.cards.map((c) => <div><h3>{c.title}</h3><p set:html={c.text} /></div>)}</div>}
        {x.table && <div class="cmp"><table><thead><tr>{x.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead><tbody>{x.table.rows.map((r) => <tr>{r.map((c, j) => j === 0 ? <th scope="row" set:html={c} /> : <td set:html={c} />)}</tr>)}</tbody></table></div>}
        {x.checklist && <ul class="checklist">{x.checklist.map((c) => <li set:html={c} />)}</ul>}
        {x.note && <p class="note" set:html={x.note} />}
      </div>
    </section>
  ))}
  <section class="sec paper">
    <div class="container">
      <div class="sec-head"><span class="eyebrow">{W.change}</span><h2>{W.gain}</h2></div>
      <div class="grid-3">{s.benefits.map((b) => <div class="card"><h3>{b.title}</h3><p>{b.text}</p></div>)}</div>
    </div>
  </section>
  <section class="sec">
    <div class="container">
      <div class="sec-head"><span class="eyebrow">{W.how}</span><h2>{consulting ? W.stepsC : W.steps}</h2></div>
      <div class="steps">{s.steps.map((st, i) => <div class="step"><span class="n">{W.step(i + 1)}</span><h3>{st.title}</h3><p>{st.text}</p></div>)}</div>
    </div>
  </section>
  <section class="sec paper">
    <div class="container">
      <div class="sec-head"><span class="eyebrow">{W.who}</span><h2>{W.fits}</h2></div>
      <div class="links-list">{secs.map((x) => x && <a class="chip" href={sectorUrl(x)}>{x.title} ›</a>)}</div>
      <div class="sec-head" style="margin-top:56px;margin-bottom:24px"><span class="eyebrow">{W.rel}</span><h2>{W.relT}</h2></div>
      <div class="grid-2">{related.map((r) => <a class="card" href={serviceUrl(r)}><span class="k">{r.short}</span><h3>{r.title}</h3><p>{r.lead}</p><span class="go">{L.explore}</span></a>)}</div>
    </div>
  </section>
  <Faq faqs={s.faqs} />
  {gd && (
    <section class="sec paper">
      <div class="container">
        <div class="sources">
          <h2>{L.sources}</h2>
          <ol>{gd.sources.map((x) => <li><a href={x.url} target="_blank" rel="noopener">{x.title}</a></li>)}</ol>
        </div>
      </div>
    </section>
  )}
  <CtaBand />
</Base>
