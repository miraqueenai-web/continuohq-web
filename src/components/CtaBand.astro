---
import { site, whatsappHref } from '../config/site';
import { langOf, link, t } from '../i18n';
export interface Props { title?: string; text?: string }
const lang = langOf(Astro.url.pathname);
const L = t(lang);
const { title = L.ctaTitle, text = L.ctaText } = Astro.props;
const wa = whatsappHref(lang);
---
<section class="sec">
  <div class="container">
    <div class="cta-band">
      <div class="glow" aria-hidden="true"></div>
      <h2>{title}</h2>
      <p>{text}</p>
      <div class="ctas">
        <a class="btn btn-gold" href={link(site.bookingPage, lang)}>{L.bookPlan}</a>
        <a class="btn btn-line" href={wa} {...(wa.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{site.whatsapp ? L.waWrite : L.writeUs}</a>
      </div>
    </div>
  </div>
</section>
