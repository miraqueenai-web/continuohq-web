---
export interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
const all = [{ name: 'Ana sayfa', href: '/' }, ...items];
---
<nav class="crumbs" aria-label="Sayfa yolu">
  <ol>
    {all.map((c, i) => <li>{i === all.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>)}
  </ol>
</nav>
