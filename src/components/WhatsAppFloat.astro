---
import { site, whatsappHref } from '../config/site';
import { langOf, t } from '../i18n';
const lang = langOf(Astro.url.pathname);
const L = t(lang);
const href = whatsappHref(lang);
---
<a class="wa-float" href={href} {...(site.whatsapp ? { target: '_blank', rel: 'noopener' } : {})} aria-label={site.whatsapp ? L.waTalkAria : L.writeUs}>
  <span class="dot" aria-hidden="true"></span><span class="t">{site.whatsapp ? L.waTalk : L.writeUs}</span>
</a>
