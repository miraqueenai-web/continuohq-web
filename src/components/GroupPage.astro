---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CtaBand from './CtaBand.astro';
import Faq from './Faq.astro';
import { site } from '../config/site';
import { groups, services, serviceUrl, sectors, sectorUrl, type Faq as FaqItem } from '../data/services';
export interface Props {
  group: 'ai-asistanlar' | 'ai-donusumu';
  toc: { id: string; title: string }[];
  faqs: FaqItem[];
  sources: { title: string; url: string }[];
  updated: string; // YYYY-AA-GG
}
const { group, toc, faqs, sources, updated } = Astro.props;
const g = groups[group];
const list = services.filter((s) => s.group === group);
const other = group === 'ai-asistanlar' ? 'ai-donusumu' : 'ai-asistanlar';
const isAi = group === 'ai-donusumu';
const url = `${site.url}/${group}`;
const upd = new Date(updated);
const updTr = upd.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const author = { '@type': 'Person', '@id': `${site.url}/yazar/neslisah-gokkaya#person`, name: site.founder, url: `${site.url}/yazar/neslisah-gokkaya` };
const ld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: site.url },
    { '@type': 'ListItem', position: 2, name: g.title, item: url } ] },
  { '@context': 'https://schema.org', '@type': 'Article', headline: g.guideTitle, description: g.description, inLanguage: 'tr-TR', mainEntityOfPage: url, dateModified: upd.toISOString(), author, publisher: { '@id': `${site.url}/#organization` } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: g.title, itemListElement: list.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.title, url: `${site.url}${serviceUrl(s)}` })) },
];
---
<Base title={g.seoTitle} description={g.description} type="article" jsonld={ld}>
  <section class={`page-hero${isAi ? ' ai-glow' : ''}`}>
    {isAi && <div class="glow" aria-hidden="true"></div>}
    <div class="container">
      <Breadcrumbs items={[{ name: g.title, href: `/${group}` }]} />
      <h1>{isAi ? <>İşinizi <span class="grad-ai">yapay zekayla</span> yeniden düzenleyin.</> : <>Müşterinize her an yanıt veren <span class="grad">AI asistanlar</span>.</>}</h1>
      <p class="lead">{g.lead}</p>
      <div class="answer"><strong>Kısaca</strong>{g.answer}</div>
      <p class="byline">Hazırlayan: <a href="/yazar/neslisah-gokkaya">{site.founder}</a> · Son güncelleme: <time datetime={updated}>{updTr}</time></p>
      <nav class="toc" aria-label="Bu sayfada">
        <span class="toc-k">Bu sayfada</span>
        {toc.map((t) => <a href={`#${t.id}`}>{t.title}</a>)}
        <a href="#hizmetler">{isAi ? 'Hizmetlerimiz' : 'Asistanlarımız'}</a>
      </nav>
    </div>
  </section>

  <div class="guide">
    <slot />
  </div>

  <section class="sec paper" id="hizmetler">
    <div class="container">
      <div class="sec-head"><span class="eyebrow">{g.menuNote}</span><h2>{isAi ? 'Neler yapıyoruz?' : 'Hangi asistan size uygun?'}</h2></div>
      <div class="grid-3">
        {list.map((s) => (
          <a class="card" href={serviceUrl(s)}>
            <span class="k">{s.short}</span>
            <h3>{s.title}</h3>
            <p>{s.lead}</p>
            <span class="go">İnceleyin ›</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Faq faqs={faqs} />

  <section class="sec paper">
    <div class="container">
      <div class="sec-head"><span class="eyebrow">Sektörler</span><h2>Sektörünüze göre başlayın</h2></div>
      <div class="links-list">
        {sectors.map((s) => <a class="chip" href={sectorUrl(s)}>{s.title} ›</a>)}
        <a class="chip" href={`/${other}`}>{groups[other].title} ›</a>
        <a class="chip" href="/blog">Blog ›</a>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="container">
      <div class="sources">
        <h2>Kaynaklar</h2>
        <ol>
          {sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.title}</a></li>)}
        </ol>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
