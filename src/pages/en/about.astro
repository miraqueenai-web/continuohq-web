---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../config/site';
const ld = [{ '@context': 'https://schema.org', '@type': 'AboutPage', name: 'About Us', url: `${site.url}/en/about`, about: { '@id': `${site.url}/#organization` } }];
---
<Base title="About Us | Continuo AI Agency" description="Continuo was founded to help businesses handle customer communication and repetitive work more easily with AI. Our principles and the way we work." jsonld={ld}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ name: 'About Us', href: '/en/about' }]} />
      <h1>We translate AI into the language of your business.</h1>
      <p class="lead">Continuo was founded to help businesses handle customer communication and repetitive work more easily with AI.</p>
    </div>
  </section>
  <section class="sec paper">
    <div class="container">
      <div class="prose">
        <h2>Why Continuo?</h2>
        <p>Continuo means "continuous" in Italian. We work so that your business can answer its customers day and night without interruption, and so that your team can focus on its real work without being worn down by repetitive tasks.</p>
        <p>AI is developing quickly, yet most businesses do not know where to start. That is where we come in: we listen to how your business works, find where AI will genuinely help and set up the system according to your rules.</p>
        <h2>Our principles</h2>
        <ul>
          <li><strong>Every assistant includes handover to a person.</strong> Sensitive or complex matters always go to your team.</li>
          <li><strong>We measure instead of promising figures.</strong> We compare results with your situation before setup.</li>
          <li><strong>Your data belongs to you.</strong> We carry out setups in line with KVKK, Türkiye's personal data protection law, and process only the data that is needed.</li>
          <li><strong>Built for your business.</strong> We set up an assistant that speaks with your own information, rather than a general chatbot.</li>
        </ul>
        <h2>Founder</h2>
        <p>Continuo was founded by <a href="/en/author/neslisah-gokkaya">{site.founder}</a>. On <a href="/en/blog">our blog</a> we share recent developments in AI and automation together with their sources.</p>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
