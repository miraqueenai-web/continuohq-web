---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Blog | Yapay Zeka Asistanları ve Otomasyon Üzerine" description="İşletmeler için yapay zeka asistanları, WhatsApp otomasyonu ve süreç otomasyonu üzerine kaynaklı, güncel yazılar." noindex={posts.length === 0}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Blog', href: '/blog' }]} />
      <h1>Blog</h1>
      <p class="lead">İşletmeler için yapay zeka asistanları ve otomasyon üzerine kaynaklı, güncel yazılar.</p>
    </div>
  </section>
  <section class="sec paper">
    <div class="container">
      {posts.length === 0 ? (
        <p class="lead" style="margin:0">İlk yazılarımız hazırlanıyor. Yakında burada olacak.</p>
      ) : (
        <div class="grid-3">
          {posts.map((p) => (
            <a class="card" href={`/blog/${p.id}`}>
              <span class="k">{p.data.date.toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <span class="go">Okuyun ›</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
  <CtaBand />
</Base>
