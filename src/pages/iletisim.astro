---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, whatsappHref } from '../config/site';
import { sectors } from '../data/services';
const ld = [{ '@context': 'https://schema.org', '@type': 'ContactPage', name: 'İletişim', url: `${site.url}/iletisim` }];
---
<Base title="İletişim | Continuo ile Ücretsiz Keşif Görüşmesi" description="Continuo ile iletişime geçin: ücretsiz keşif görüşmesi planlayın, form doldurun veya e-posta gönderin." jsonld={ld}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ name: 'İletişim', href: '/iletisim' }]} />
      <h1>İşinizi konuşalım.</h1>
      <p class="lead">En hızlı yol 30 dakikalık ücretsiz keşif görüşmesi. Dilerseniz formu doldurun, en geç bir iş günü içinde dönelim.</p>
      <div class="ctas"><a class="btn btn-dark" href={site.bookingPage}>Keşif görüşmesi planlayın</a>{site.whatsapp && <a class="btn btn-line" href={whatsappHref()} target="_blank" rel="noopener">WhatsApp'tan yazın</a>}</div>
    </div>
  </section>
  <section class="sec paper">
    <div class="container contact-grid">
      <form class="form" id="form" name="iletisim" method="post" data-netlify="true" netlify-honeypot="web">
        <input type="hidden" name="form-name" value="iletisim" />
        <input type="hidden" name="subject" data-remove-prefix value="Yeni talep: continuohq.com iletişim formu" />
        <p hidden><label>Bu alanı boş bırakın<input name="web" /></label></p>
        <label>Adınız<input id="ad" name="ad" autocomplete="name" required /></label>
        <label>E-posta<input id="eposta" name="email" type="email" autocomplete="email" required /></label>
        <label>İşletmenizin adı<input id="isletme" name="isletme" autocomplete="organization" /></label>
        <label>Sektör
          <select id="sektor" name="sektor">
            {sectors.map((s) => <option>{s.title === 'Tüm Sektörler' ? 'Diğer' : s.title}</option>)}
          </select>
        </label>
        <label>Neyi çözmek istiyorsunuz?<textarea id="mesaj" name="mesaj" rows="5" required></textarea></label>
        <p class="small">Lütfen sağlık bilgisi gibi özel nitelikli kişisel veri paylaşmayın. Bilgileriniz <a href="/kvkk-aydinlatma-metni" style="text-decoration:underline">KVKK Aydınlatma Metni</a> kapsamında işlenir.</p>
        <button class="btn btn-dark" id="form-btn" type="submit" style="justify-self:start;border:0;cursor:pointer">Gönder</button>
        <p class="form-err" id="form-err" role="alert" hidden></p>
      </form>
      <div class="form-done" id="form-done" tabindex="-1" hidden>
        <span class="form-done-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
        <h2>Mesajınız bize ulaştı.</h2>
        <p>Teşekkürler <span id="form-name"></span>. En geç bir iş günü içinde <b id="form-mail"></b> adresinize dönüyoruz.</p>
        <p class="small">Beklemek istemezseniz hemen bir keşif görüşmesi de planlayabilirsiniz.</p>
        <div class="ctas"><a class="btn btn-dark" href={site.bookingPage}>Görüşme planlayın</a><button class="btn btn-line" id="form-again" type="button" style="cursor:pointer">Yeni mesaj gönderin</button></div>
      </div>
      <div class="prose">
        <h2 style="margin-top:0">Doğrudan ulaşın</h2>
        <p>Genel sorular: <a href={`mailto:${site.email.info}`}>{site.email.info}</a></p>
        <p>Teklif talepleri: <a href={`mailto:${site.email.teklif}`}>{site.email.teklif}</a></p>
        <p>Müşteri desteği: <a href={`mailto:${site.email.destek}`}>{site.email.destek}</a></p>
        <h2>Hizmet bölgesi</h2>
        <p>Türkiye genelinde, tamamen uzaktan çalışıyoruz.</p>
      </div>
    </div>
  </section>
</Base>
<script define:vars={{ endpoint: site.formEndpoint, mail: site.email.teklif }}>
  const form = document.getElementById('form');
  const btn = document.getElementById('form-btn');
  const err = document.getElementById('form-err');
  const done = document.getElementById('form-done');
  const showError = (text) => { err.textContent = text; err.hidden = false; err.scrollIntoView({ behavior: 'smooth', block: 'center' }); };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.hidden = true;
    const data = new FormData(form);
    if (!endpoint) {
      const body = [...data.entries()].map(([k, v]) => `${k}: ${v}`).join('\n');
      location.href = `mailto:${mail}?subject=${encodeURIComponent('Web sitesi talebi')}&body=${encodeURIComponent(body)}`;
      showError(`E-posta uygulamanız açılmadıysa bize ${mail} adresinden yazabilirsiniz.`);
      return;
    }
    btn.disabled = true;
    btn.textContent = 'Gönderiliyor…';
    try {
      const r = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(data).toString() });
      if (!r.ok) throw new Error();
      document.getElementById('form-name').textContent = String(data.get('ad') || '').trim().split(' ')[0];
      document.getElementById('form-mail').textContent = String(data.get('email') || '');
      form.reset();
      form.hidden = true;
      done.hidden = false;
      done.scrollIntoView({ behavior: 'smooth', block: 'center' });
      done.focus({ preventScroll: true });
    } catch {
      showError(`Mesajınız gönderilemedi. Lütfen tekrar deneyin ya da doğrudan ${mail} adresine yazın.`);
    } finally {
      btn.disabled = false;
      btn.textContent = 'Gönder';
    }
  });
  document.getElementById('form-again').addEventListener('click', () => {
    done.hidden = true;
    form.hidden = false;
    document.getElementById('ad').focus();
  });
</script>
