---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import DemoChat from '../components/DemoChat.astro';
import { site, whatsappHref } from '../config/site';
import { sectors, sectorUrl } from '../data/services';

const needs = [
  { k: 'Müşteri iletişimi', h: 'Mesajlara yetişemiyoruz.', p: 'WhatsApp ve Instagram mesajları 7/24, işletmenizin bilgisiyle yanıtlanır.', go: 'WhatsApp Asistanı', href: '/ai-asistanlar/whatsapp-asistani' },
  { k: 'Randevu & rezervasyon', h: 'Takvim karışıyor.', p: 'Randevular otomatik alınır, hatırlatılır, iptaller yeniden doldurulur.', go: 'Randevu & Rezervasyon', href: '/ai-asistanlar/randevu-rezervasyon' },
  { k: 'Satış & teklif', h: 'Teklifler geç çıkıyor.', p: 'Talep geldiği anda teklif taslağı hazır, takip hatırlatmaları otomatik.', go: 'AI Ajanları', href: '/ai-donusumu/ai-ajanlari' },
  { k: 'Operasyon', h: 'Aynı işi her gün elle yapıyoruz.', p: 'Tekrarlayan adımlar uçtan uca otomatikleşir, ekibiniz asıl işe döner.', go: 'Süreç Otomasyonları', href: '/ai-donusumu/surec-otomasyonlari', dark: true },
  { k: 'İK & ekip', h: 'Evrak işi vaktimizi alıyor.', p: 'İşe alım, izin ve personel belgeleri tek bir akışta düzenlenir.', go: 'Süreç Otomasyonları', href: '/ai-donusumu/surec-otomasyonlari' },
  { k: 'Raporlama & veri', h: 'Rakamları toplamak günler sürüyor.', p: 'Dağınık tablolardan haftalık özetler kendiliğinden hazırlanır.', go: 'Süreç Otomasyonları', href: '/ai-donusumu/surec-otomasyonlari' },
  { k: 'Belge & bilgi', h: 'Bilgiler her yere dağılmış.', p: 'Dosyalar, e-postalar ve notlar sorulabilir tek bir bilgi bankasında toplanır.', go: 'AI Ajanları', href: '/ai-donusumu/ai-ajanlari' },
  { k: 'Tedarik & stok', h: 'Stok takibi elle yürüyor.', p: 'Sipariş, stok ve tedarikçi yazışmaları otomatik izlenir, eksik önceden haber verilir.', go: 'Entegrasyonlar', href: '/ai-donusumu/entegrasyonlar' },
];
const tiles = sectors.filter((s) => s.slug !== 'tum-sektorler');
const tileClass: Record<string, string> = { 'konaklama-turizm': 't1', 'guzellik-estetik': 't2', 'saglik-beslenme': 't3' };
const wa = whatsappHref();
// Telefon demosu: ekranda kaldıkça sırayla oynayan örnek konuşmalar
const scenes = [
  { name: 'Örnek Otel', cap: "Örnek senaryo · Otel. Gece 02:14'te gelen soru, sabahı beklemeden yanıtlanıyor.", msgs: [
    { k: 'in', x: 'Merhaba, 14–16 Kasım için iki kişilik oda var mı?', t: '02:14' },
    { k: 'out', x: 'Merhaba! 14–16 Kasım için deniz manzaralı çift kişilik odamız müsait. Kahvaltı dahil gecelik fiyatı göndereyim mi?', t: '02:14' },
    { k: 'in', x: 'Evet lütfen, bir de otopark var mı?', t: '02:15' },
    { k: 'out', x: 'Ücretsiz otoparkımız var. Fiyat ve rezervasyon bağlantısını iletiyorum.', t: '02:15' },
    { k: 'handoff', x: "Sabah 09:00'da resepsiyon ekibi konuşmayı devralabilir" } ] },
  { name: 'Örnek Güzellik Merkezi', cap: 'Örnek senaryo · Güzellik merkezi. Mesai sonrası gelen randevu talebi takvime işleniyor.', msgs: [
    { k: 'in', x: 'Merhaba, cumartesi cilt bakımı için yer var mı?', t: '23:42' },
    { k: 'out', x: 'Merhaba! Cumartesi 11:00 ve 15:30 boş. Hangisini ayırayım?', t: '23:42' },
    { k: 'in', x: '15:30 olsun.', t: '23:43' },
    { k: 'out', x: 'Cumartesi 15:30 için randevunuzu oluşturdum. Bir gün önce hatırlatma göndereceğim.', t: '23:43' },
    { k: 'handoff', x: 'Randevu takvime eklendi · ekip bilgilendirildi' } ] },
  { name: 'Örnek Beslenme Danışmanlığı', cap: 'Örnek senaryo · Diyetisyen. Sağlıkla ilgili sorular her zaman uzmana yönlendiriliyor.', msgs: [
    { k: 'in', x: 'Merhaba, online görüşme yapıyor musunuz?', t: '21:08' },
    { k: 'out', x: 'Merhaba! Evet, online görüşmelerimiz var. Uygun saatleri ve ücret bilgisini iletiyorum.', t: '21:08' },
    { k: 'in', x: 'Glutensiz beslenmem gerekiyor, buna göre liste hazırlanır mı?', t: '21:09' },
    { k: 'out', x: 'Bu konuyu diyetisyenimiz görüşmede sizinle birlikte değerlendirir. İsterseniz ilk görüşmenizi planlayalım.', t: '21:09' },
    { k: 'handoff', x: 'Sağlıkla ilgili soru diyetisyene iletildi' } ] },
];
const first = scenes[0];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Continuo',
  url: site.url,
  description: site.description,
  areaServed: { '@type': 'Country', name: 'Türkiye' },
  serviceType: ['Yapay zeka asistanı', 'WhatsApp asistanı', 'Süreç otomasyonu', 'Yapay zeka danışmanlığı'],
  email: site.email.info,
};
---
<Base
  title="Continuo | Yapay Zeka Ajansı: İşletmenize Özel AI Asistanlar ve Otomasyon"
  description="Continuo, işletmelere özel yapay zeka asistanları ve otomasyonlar kuran bir yapay zeka ajansıdır. WhatsApp ve Instagram asistanları, randevu ve süreç otomasyonu."
  jsonld={[faqLd]}
>
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Yapay Zeka Ajansı</span>
      <h1>İşletmeniz artık <span class="grad">hiç uyumuyor.</span></h1>
      <p class="lead">İşletmenize özel <span class="grad gold-word">yapay zeka</span> asistanları ve otomasyonlar. Mesajları yanıtlar, randevuları yönetir, tekrarlayan işleri üstlenir.</p>
      <div class="ctas">
        {site.whatsapp ? (
          <>
            <a class="btn btn-dark" href={wa} target="_blank" rel="noopener">Asistanımızla konuşun</a>
            <a class="btn btn-line" href={site.bookingPage}>Ücretsiz keşif görüşmesi</a>
          </>
        ) : (
          <>
            <a class="btn btn-dark" href={site.bookingPage}>Ücretsiz keşif görüşmesi</a>
            <a class="btn btn-line" href="/iletisim">Bize yazın</a>
          </>
        )}
      </div>
      <div class="demo-wrap">
        <div class="glow" aria-hidden="true"></div>
        <div class="phone" role="img" aria-label="Örnek bir işletmenin WhatsApp asistanıyla yapılan konuşma">
          <div class="screen">
            <div class="chat-head">
              <span class="av" style="--mk-ink:#111"><svg viewBox="0 0 100 100" aria-hidden="true"><use href="#mk"/></svg></span>
              <span><b id="demo-name">{first.name}</b><small>Asistan · çevrim içi</small></span>
            </div>
            <div class="msgs anim" id="demo" data-scenes={JSON.stringify(scenes)}>
              {first.msgs.map((m) => <div class={`m ${m.k}`}>{m.x}{m.t && <span class="t">{m.t}</span>}</div>)}
            </div>
          </div>
        </div>
        <p class="demo-cap" id="demo-cap">{first.cap}</p>
      </div>
    </div>
  </section>

  <section class="statement">
    <div class="container">
      <p id="stmt">Müşterileriniz cevap beklemez. Ekibiniz tekrarlayan işlerde tükenmemeli. Biz her işletmeye kendi diliyle konuşan, kendi kurallarıyla çalışan <span class="gw">yapay zeka sistemleri</span> kuruyoruz.</p>
    </div>
  </section>

  <DemoChat />

  <section class="sec paper" id="ihtiyaclar">
    <div class="container">
      <div class="sec-head reveal">
        <span class="eyebrow">İhtiyacınızdan başlayın</span>
        <h2>Sizi en çok ne yoruyor?</h2>
        <p>Mesajlaşmadan raporlamaya, işe alımdan stoğa. Önce sorunu konuşuruz, sonra ona uygun sistemi kurarız.</p>
      </div>
    </div>
    <div class="slider">
      <div class="track" id="track">
        {needs.map((n) => (
          <a class={`need${n.dark ? ' dark' : ''}`} href={n.href}>
            <div><span class="k">{n.k}</span><h3>{n.h}</h3></div>
            <p>{n.p}</p>
            <span class="go">{n.go} ›</span>
          </a>
        ))}
      </div>
      <div class="slider-ctrl">
        <button class="slider-btn" type="button" data-dir="-1" aria-label="Önceki kartlar">‹</button>
        <button class="slider-btn" type="button" data-dir="1" aria-label="Sonraki kartlar">›</button>
      </div>
    </div>
  </section>

  <section class="sec" id="sektorler">
    <div class="container">
      <div class="sec-head reveal">
        <span class="eyebrow">Sektörler</span>
        <h2>Sektörünüzün dilini konuşur.</h2>
        <p>Her sektörün soruları, kuralları ve yoğun saatleri farklıdır. Asistanınız bunları bilerek kurulur.</p>
      </div>
      <div class="sectors">
        {tiles.map((s) => (
          <a class={`tile ${tileClass[s.slug]} reveal`} href={sectorUrl(s)} style={s.image ? `background-image:url(${s.image})` : undefined}>
            <div><h3>{s.title}</h3><p>{s.lead}</p></div>
            <span class="go">Keşfedin ›</span>
          </a>
        ))}
        <a class="tile t4 reveal" href="/sektorler/tum-sektorler">
          <div><span class="plus" aria-hidden="true">+</span><h3>Sektörünüz listede yok mu?</h3><p>Süreçlerinizi anlatın, size özel kurgulayalım. Her işletmenin otomatikleşebilecek bir işi vardır.</p></div>
          <span class="go">Bize anlatın →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="sec paper" id="surec">
    <div class="container">
      <div class="sec-head reveal">
        <span class="eyebrow">Nasıl çalışırız</span>
        <h2>Dört aşamalı çalışma yöntemimiz.</h2>
      </div>
      <div class="steps">
        <div class="step reveal"><span class="n">1. Keşif</span><h3>Dinliyoruz</h3><p>30 dakikalık ücretsiz görüşmede işinizi ve sizi en çok yoran noktaları konuşuyoruz.</p></div>
        <div class="step reveal"><span class="n">2. Kurgu</span><h3>Tasarlıyoruz</h3><p>Hangi işin otomatikleşeceğini, nerede insana devredileceğini birlikte netleştiriyoruz.</p></div>
        <div class="step reveal"><span class="n">3. Kurulum</span><h3>Kuruyoruz</h3><p>Asistanı işletmenizin bilgisiyle eğitip mevcut kanallarınıza bağlıyoruz.</p></div>
        <div class="step reveal"><span class="n">4. Ölçüm</span><h3>İyileştiriyoruz</h3><p>Kurulum öncesi ve sonrasını kıyaslıyor, sistemi her ay geliştiriyoruz.</p></div>
      </div>
      <p style="margin-top:28px"><a class="chip" href="/nasil-calisiriz">Süreci ayrıntılı inceleyin ›</a></p>
    </div>
  </section>

  <section class="sec principle">
    <div class="container reveal">
      <span class="eyebrow">İlkemiz</span>
      <p class="big">Her asistanda <span class="grad">insana devir</span> vardır.</p>
      <p class="sub">Yapay zeka işin hızlı kısmını üstlenir. Hassas, karmaşık ya da duygusal bir konu açıldığında konuşma ekibinize geçer. Müşteriniz hiçbir zaman çıkmaza girmez.</p>
    </div>
  </section>

  {site.whatsapp
    ? <CtaBand title="Ürünümüzü konuşarak deneyin." text="WhatsApp asistanımız da bizim kurduğumuz bir sistem. Sorularınızı ona sorun ya da 30 dakikalık ücretsiz keşif görüşmesi planlayın." />
    : <CtaBand />}
</Base>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stmt = document.getElementById('stmt');
  if (stmt) {
    const walk = (node: Node) => {
      [...node.childNodes].forEach((n) => {
        if (n.nodeType === 3) {
          const frag = document.createDocumentFragment();
          (n.textContent || '').split(/(\s+)/).forEach((part) => {
            if (!part || /^\s+$/.test(part)) { frag.append(part); return; }
            const s = document.createElement('span'); s.className = 'w'; s.textContent = part; frag.append(s);
          });
          n.replaceWith(frag);
        } else walk(n);
      });
    };
    walk(stmt);
    const words = [...stmt.querySelectorAll<HTMLElement>('.w')];
    const paint = () => {
      if (reduce) return;
      const r = stmt.getBoundingClientRect();
      const start = innerHeight * 0.85, end = innerHeight * 0.3;
      const p = Math.min(1, Math.max(0, (start - r.top) / (start - end + r.height * 0.6)));
      const lit = p * words.length;
      words.forEach((w, i) => { w.style.opacity = i < lit ? '1' : '0.22'; });
    };
    addEventListener('scroll', paint, { passive: true });
    addEventListener('resize', paint);
    paint();
  }
  // Telefon demosu: bölüm görünür oldukça konuşmalar sırayla ve tekrar tekrar akar
  const demo = document.getElementById('demo');
  const demoName = document.getElementById('demo-name');
  const demoCap = document.getElementById('demo-cap');
  if (demo && demoName && demoCap && !reduce && 'IntersectionObserver' in window) {
    type Msg = { k: string; x: string; t?: string };
    const scenes: { name: string; cap: string; msgs: Msg[] }[] = JSON.parse(demo.dataset.scenes || '[]');
    let idx = 0, run = 0, visible = false, timer = 0;
    const wait = (ms: number) => new Promise<void>((r) => { timer = window.setTimeout(r, ms); });
    const bubble = (m: Msg) => {
      const el = document.createElement('div');
      el.className = `m ${m.k}`;
      el.textContent = m.x;
      if (m.t) { const t = document.createElement('span'); t.className = 't'; t.textContent = m.t; el.append(t); }
      return el;
    };
    const play = async () => {
      const my = ++run;
      const alive = () => visible && my === run;
      while (alive()) {
        const sc = scenes[idx];
        demo.classList.add('fading');
        await wait(400); if (!alive()) return;
        demo.replaceChildren();
        demoName.textContent = sc.name;
        demoCap.textContent = sc.cap;
        demo.classList.remove('fading');
        await wait(500);
        for (const m of sc.msgs) {
          if (!alive()) return;
          if (m.k === 'out') {
            const typing = document.createElement('div');
            typing.className = 'm out typing';
            typing.innerHTML = '<i></i><i></i><i></i>';
            demo.append(typing);
            await wait(1100); typing.remove(); if (!alive()) return;
          }
          demo.append(bubble(m));
          await wait(m.k === 'in' ? 1300 : 1500);
        }
        await wait(3200);
        idx = (idx + 1) % scenes.length;
      }
    };
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) play(); else { run++; clearTimeout(timer); }
    }, { threshold: 0.4 }).observe(demo);
  }
  const track = document.getElementById('track');
  document.querySelectorAll<HTMLButtonElement>('.slider-btn').forEach((b) => b.addEventListener('click', () => {
    if (!track) return;
    track.scrollBy({ left: Number(b.dataset.dir) * Math.min(track.clientWidth * 0.8, 720), behavior: reduce ? 'auto' : 'smooth' });
  }));
</script>
