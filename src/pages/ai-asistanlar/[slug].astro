---
import ServicePage from '../../components/ServicePage.astro';
import { services } from '../../data/services';
export function getStaticPaths() {
  return services.filter((s) => s.group === 'ai-asistanlar').map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
---
<ServicePage s={s} />
