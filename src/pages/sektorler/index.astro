---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../config/site';
import { sectors, sectorUrl } from '../../data/services';
const tiles = sectors.filter((s) => s.slug !== 'tum-sektorler');
const tileClass: Record<string, string> = { 'konaklama-turizm': 't1', 'guzellik-estetik': 't2', 'saglik-beslenme': 't3' };
const ld = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: site.url },
  { '@type': 'ListItem', position: 2, name: 'Sektörler', item: `${site.url}/sektorler` } ] }];
---
<Base title="Sektörler: Otel, Güzellik ve Sağlık için AI Asistan" description="Oteller, güzellik merkezleri, diyetisyenler ve her sektörden işletme için yapay zeka asistanları ve otomasyonlar. Sektörünüzün diliyle konuşan çözümler." jsonld={ld}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Sektörler', href: '/sektorler' }]} />
      <h1>Sektörünüzün dilini konuşur.</h1>
      <p class="lead">Her sektörün soruları, kuralları ve yoğun saatleri farklıdır. Asistanınız bunları bilerek kurulur.</p>
      <div class="answer"><strong>Kısaca</strong>Şu an ağırlıklı olarak konaklama ve turizm, güzellik ve estetik, sağlık ve beslenme alanlarındaki işletmelerle çalışıyoruz. Sektörünüz bu listede yoksa da süreçlerinize göre size özel bir kurgu hazırlayabiliriz.</div>
    </div>
  </section>
  <section class="sec" style="padding-top:0">
    <div class="container">
      <div class="sectors">
        {tiles.map((s) => (
          <a class={`tile ${tileClass[s.slug]}`} href={sectorUrl(s)} style={s.image ? `background-image:url(${s.image})` : undefined}>
            <div><h3>{s.title}</h3><p>{s.lead}</p></div>
            <span class="go">Keşfedin ›</span>
          </a>
        ))}
        <a class="tile t4" href="/sektorler/tum-sektorler">
          <div><span class="plus" aria-hidden="true">+</span><h3>Sektörünüz listede yok mu?</h3><p>Süreçlerinizi anlatın, size özel kurgulayalım.</p></div>
          <span class="go">Bize anlatın →</span>
        </a>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
